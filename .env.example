# Copy to .env for local development (`cp .env.example .env`).
# docker-compose.yml sets its own values; see that file for container settings.

# --- Required -----------------------------------------------------------------
DATABASE_URL=postgresql://snapland:snapland@localhost:5432/snapland
REDIS_URL=redis://localhost:6379

# Public origin of the app. Used for CORS, CSRF/WebSocket Origin checks and the
# cookie Secure flag (https origin => Secure cookies).
APP_ORIGIN=http://localhost:3000

# --- Map ----------------------------------------------------------------------
# govmap.gov.il API token (domain-bound, public by design). Without a token the
# govmap engine is hidden unless GOVMAP_MODE=mock.
GOVMAP_TOKEN=
# live (default when a token is set) | mock (in-browser fake, no network) | disabled
GOVMAP_MODE=
# leaflet (default) | govmap
MAP_DEFAULT_ENGINE=leaflet
# lng,lat and metres/pixel of the initial view (default: Tel Aviv, 20 m/px)
MAP_DEFAULT_CENTER=34.7818,32.0853
MAP_DEFAULT_RESOLUTION=20
# GOVMAP_SCRIPT_URL=https://www.govmap.gov.il/govmap/api/govmap.api.js

# govmap orthophoto tiles for the Leaflet engine, in the ITM (EPSG:2039) grid.
# Leave empty to hide the layer. {z}/{x}/{y} placeholders; origin "x,y" (top-left,
# ITM metres); resolutions: metres/pixel per zoom level, comma separated.
GOVMAP_ORTHO_TILE_URL=
GOVMAP_ORTHO_ORIGIN=
GOVMAP_ORTHO_RESOLUTIONS=
# Development aid: serve labelled SVG tiles in the ITM grid from /api/dev/itm-tiles.
# ENABLE_DEV_TILES=true
# GOVMAP_ORTHO_TILE_URL=/api/dev/itm-tiles/{z}/{x}/{y}

# --- Server -------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# Extra allowed origins (comma separated), e.g. a separate front-end domain.
# ALLOWED_ORIGINS=
# Behind a reverse proxy: take the client IP from X-Forwarded-For.
# TRUST_PROXY=false
# COOKIE_SECURE=            # defaults to true for https APP_ORIGIN
# LOG_LEVEL=info            # fatal|error|warn|info|debug|trace|silent
# REQUEST_TIMEOUT_MS=10000
# EXPOSE_DEBUG_HANDLE=false # window.__snapland in production (e2e against prod builds)

# --- Database & cache ---------------------------------------------------------
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=5000
# REDIS_KEY_PREFIX=snapland:
# AREA_CACHE_TTL_SECONDS=60  # 0 disables the viewport cache
# MAX_AREAS_PER_QUERY=2000

# --- Limits, sessions, retention ----------------------------------------------
# DRAW_RATE_LIMIT_PER_MIN=50
# LOGIN_RATE_LIMIT=10       # per IP+email per 15 min
# REGISTER_RATE_LIMIT=5     # per IP per hour
# SESSION_TTL_SECONDS=604800
# WS_MAX_CONNECTIONS_PER_USER=10
# SOFT_DELETE_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365
# RETENTION_INTERVAL_MINUTES=360  # 0 disables the in-process purge timer

# --- Tests --------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://snapland:snapland@localhost:5432/snapland_test
# TEST_REDIS_URL=redis://localhost:6379/15
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
