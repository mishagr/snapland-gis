{
  "name": "snapland-gis",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative real-time GIS polygon drawing on govmap.gov.il and Leaflet/OpenStreetMap",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "retention:purge": "tsx scripts/retention.ts",
    "bench:bbox": "tsx scripts/bench-bbox.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "geographiclib-geodesic": "2.2.0",
    "ioredis": "6.0.0",
    "leaflet": "1.9.4",
    "next": "16.3.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "proj4": "2.22.0",
    "proj4leaflet": "1.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/proj4": "2.19.0",
    "@types/proj4leaflet": "1.0.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
